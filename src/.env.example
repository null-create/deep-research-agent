# ── Vite build-time vars (baked into the JS bundle at `npm run build`) ───────
# Used by `npm run dev` (Vite dev server) and Docker image builds.
# For Azure: set VITE_API_URL to the backend Container App HTTPS URL and
# VITE_WS_URL to the corresponding wss:// URL before building the frontend image.
VITE_API_URL=http://localhost:9999
VITE_WS_URL=ws://localhost:9999/ws/research

# ── nginx runtime vars (injected into the nginx container at startup) ────────
# Used by `make run-all` (docker-compose-full.yml) and the Azure Container App.
# nginx substitutes these into nginx.conf via its template mechanism (envsubst).
# In Azure these are set automatically by Terraform.
#
# Docker local (make run-all): use the Docker Compose service names so nginx
# can reach the other containers over the internal compose network.
NGINX_BACKEND_URL=http://research-assistant:9999
# No path suffix — nginx appends the full request URI to this URL.
# /files/upload → http://mcp-file-handler-server:9191/files/upload
NGINX_FILE_HANDLER_URL=http://mcp-file-handler-server:9191